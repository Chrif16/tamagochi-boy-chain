const Animation *currentAnim = &IDLE_ANIM;
uint32_t animStartedAt = 0;


void playAnimation(const Animation &anim){
  currentAnim = &anim;
  animStartedAt= millis();
}

const uint8_t* currentFrame(uint32_t now){
  uint32_t index = (now- animStartedAt) / currentAnim ->frameMs;
  if (index >= currentAnim->frameCount){
    if (currentAnim->loops){
      index%= currentAnim->frameCount;
    }else{
      playAnimation(IDLE_ANIM);
      index=0;
    }
  }
  return currentAnim->frames[index];
}


