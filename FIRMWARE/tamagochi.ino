void drawFrame(int x, int y, const uint8_t * frame){
  const int bytesPerRow = FRAME_W / 8;
  for (int row = 0; row < FRAME_H; row++){
    for(int col =0;col< FRAME_W; col++){
      uint8_t b = pgm_read_byte(&frame[row* bytesPerRow + col / 8]);
      if (b& (0x80 >> (col%8))){
        display.fillRect(x+col * FRAME_SCALE, y + row * FRAME_SCALE, FRAME_SCALE, FRAME_SCALE, 0xFFFF );
      }
    }
  }
}

